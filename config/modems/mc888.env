# ARCH6 modem profile: ZTE MC888
# Keep the first Windows pilot self-contained: runtime truth surfaces and
# exported logs live beside the installed app tree, not under /home.

MC888_HOST="192.168.0.1"
MC888_USER="admin"
MC888_PASS=""
MC888_WIFI_SSIDS=""
MC888_EXPECTED_MODEL="MC888"
MC888_EXPECTED_SERIAL=""
MC888_EXPECTED_IMEI=""
SAMPLE_INTERVAL="2.0"

# Portable Windows lane: write runtime + memory beside the installed app.
RUNTIME_DIR="./portable_runtime/guc_output"
MEMORY_DIR="./portable_runtime/guc_memory"

# Optional NIC binding for ping probes, leave empty for default routing.
PING_IFACE=""
