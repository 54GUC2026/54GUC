# ARCH6 modem profile: Huawei B818
# Loaded by start_b818.sh (or via ARCH6_MODEM_CONFIG override).

B818_HOST="192.168.5.1"
B818_USER="admin"
B818_PASS=""
B818_WIFI_SSIDS=""
B818_EXPECTED_MODEL=""
B818_EXPECTED_SERIAL=""
B818_EXPECTED_IMEI=""
SAMPLE_INTERVAL="2.0"

# Leave runtime roots blank in the shipped profile. Launchers/supervisor own
# runtime placement; direct shell starts still fall back to repo-local paths.
RUNTIME_DIR=""
MEMORY_DIR=""

# Signal normalization scales (backend unit contract).
# If this modem reports x10 encoded values, set corresponding scale to 0.1.
SINR_SCALE="1.0"
RSRP_SCALE="1.0"
RSRQ_SCALE="1.0"
RSSI_SCALE="1.0"
SIGNAL_CONTRACT_WARN="1"
EMERGENCY_SINR_FLOOR="0.0"

# Optional NIC binding for ping probes, leave empty for default routing.
PING_IFACE=""
