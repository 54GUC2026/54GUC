# ARCH6 modem profile: Huawei B535 family
# Generic launcher profile. Exact SKU/firmware is discovered after login.

B535_HOST="192.168.8.1"
B535_USER="admin"
B535_PASS=""
B535_WIFI_SSIDS=""
B535_EXPECTED_MODEL=""
B535_EXPECTED_SERIAL=""
B535_EXPECTED_IMEI=""
SAMPLE_INTERVAL="2.0"

# Signal normalization scales (backend unit contract).
SINR_SCALE="1.0"
RSRP_SCALE="1.0"
RSRQ_SCALE="1.0"
RSSI_SCALE="1.0"
SIGNAL_CONTRACT_WARN="1"

# Optional NIC binding for ping probes, leave empty for default routing.
PING_IFACE=""
