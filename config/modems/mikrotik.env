# ARCH6 modem profile: MikroTik
# Loaded by start.sh (or via ARCH6_MODEM_CONFIG override).

ROUTER_HOST=""
ROUTER_USER="admin"
ROUTER_PASS=""
SAMPLE_INTERVAL="2.0"

# Signal normalization scales (backend unit contract).
# If this modem reports x10 encoded RSRQ/SINR/etc, set corresponding scale to 0.1.
SINR_SCALE="1.0"
RSRP_SCALE="1.0"
RSRQ_SCALE="1.0"
RSSI_SCALE="1.0"
SIGNAL_CONTRACT_WARN="1"

# RouterOS API connect behavior.
ROUTER_API_TIMEOUT="30.0"
ROUTER_API_CONNECT_RETRIES="3"
ROUTER_API_CONNECT_RETRY_SLEEP="1.5"

# MikroTik polling/AT pacing:
# - traffic counters are read each tick (fast path)
# - modem-facing RF/AT reads are throttled to avoid modem/API overload
MIKROTIK_RF_MONITOR_INTERVAL="3.0"
MIKROTIK_QCAINFO_INTERVAL="8.0"
MIKROTIK_QNWCFG_MCS_INTERVAL="6.0"
MIKROTIK_QENG_MCS_INTERVAL="15.0"
# Safe live default: RouterOS monitor/config is the authority. Continuous
# at-chat enrichment is opt-in because some RouterOS/MBIM/Quectel paths reset LTE.
MIKROTIK_AT_LIVE_POLLING="0"
MIKROTIK_RUNTIME_CAPABILITY_PROBE="0"
MIKROTIK_AT_READ_DELAY="1.0"
MIKROTIK_AT_WRITE_DELAY="5.0"
MIKROTIK_AT_BUS_GUARD="0.8"
MIKROTIK_ACTION_MIN_SESSION_UPTIME="60.0"
MIKROTIK_POST_WRITE_BLACKOUT="10.0"
MIKROTIK_AT_LATENCY_WARN_MS="1500.0"
MIKROTIK_AT_BUS_GUARD_MAX="0.8"
MIKROTIK_AT_BUS_GUARD_STEP="0.1"
